{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Tenovo Hjälpcenter",
  "description": "Guider och dokumentation för att komma igång och få ut det mesta av Tenovo.",
  "colors": {
    "primary": "#208B8B",
    "light": "#29A3A3",
    "dark": "#1A7373"
  },
  "fonts": {
    "family": "Plus Jakarta Sans"
